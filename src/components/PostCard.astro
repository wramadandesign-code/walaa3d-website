---
import Icon from './Icon.astro';
import { readingMinutes, formatDate, type Post } from '@/lib/blog';

interface Props { post: Post; headingLevel?: 'h2' | 'h3'; featured?: boolean }
const { post, headingLevel: H = 'h2', featured = false } = Astro.props;
const { title, summary, cover, coverAlt, category, pubDate } = post.data;
---

<article class:list={['group', featured && 'md:col-span-2']} data-reveal>
  <a href={`/blog/${post.id}/`} class:list={['grid gap-6', featured && 'md:grid-cols-2 md:items-center md:gap-10']}>
    <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-night">
      <picture>
        <source srcset={`/media/posters/${cover}.webp`} type="image/webp" />
        <img src={`/media/posters/${cover}.jpg`} alt={coverAlt} loading="lazy" decoding="async" width="1600" height="1000" class="h-full w-full object-cover transition-transform duration-[1.2s] ease-out-expo group-hover:scale-[1.04]" />
      </picture>
    </div>
    <div>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs uppercase tracking-[0.14em] text-ink-soft">
        <span class="text-gold-deep">{category}</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span>{readingMinutes(post)} min read</span>
      </p>
      <H class:list={['mt-3 font-display font-medium leading-tight', featured ? 'text-3xl sm:text-4xl' : 'text-2xl']}>{title}</H>
      <p class="mt-3 leading-relaxed text-ink-soft">{summary}</p>
      <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium">Read article <Icon name="arrow" class="size-4 transition-transform duration-300 group-hover:translate-x-1" /></span>
    </div>
  </a>
</article>
