---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[]; title?: string; eyebrow?: string }
const { items, title = 'Frequently asked questions', eyebrow = 'FAQ' } = Astro.props;
---

<section class="container-x grid gap-10 py-20 sm:py-28 lg:grid-cols-12" aria-labelledby="faq-title">
  <div class="lg:col-span-4" data-reveal>
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="faq-title" class="mt-5 font-display text-4xl font-medium leading-[1.05] sm:text-5xl">{title}</h2>
  </div>
  <div class="divide-y divide-line border-y border-line lg:col-span-7 lg:col-start-6" data-reveal>
    {items.map((f) => (
      <details class="group py-2">
        <summary class="flex cursor-pointer items-center justify-between gap-6 py-4 font-display text-lg font-medium sm:text-xl">
          {f.q}
          <span class="faq-icon grid size-9 shrink-0 place-items-center rounded-full border border-line transition-transform duration-300 group-open:bg-gold group-open:border-gold"><Icon name="plus" class="size-4" /></span>
        </summary>
        <p class="pb-5 pr-12 leading-relaxed text-ink-soft">{f.a}</p>
      </details>
    ))}
  </div>
</section>
