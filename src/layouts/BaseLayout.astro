---
import { originOf, abs } from '@/config/urls';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFab from '@/components/WhatsAppFab.astro';
import { site } from '@/config/site';
import { services } from '@/data/services';

interface Props {
  /** Page title without brand suffix. Omit on the homepage to use the full SEO title. */
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'video.other';
  noindex?: boolean;
  /** Extra JSON-LD objects for this page */
  schema?: Record<string, unknown>[];
  breadcrumbs?: { name: string; href: string }[];
}

const { title, description = site.description, image = site.ogImage, type = 'website', noindex = false, schema = [], breadcrumbs } = Astro.props;

const fullTitle = title ? site.titleTemplate.replace('%s', title) : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href; // pathname already includes the base
const ogImage = abs(Astro.site!, image);
const origin = originOf(Astro.site!);

const sameAs = Object.values(site.social).filter(Boolean);

const baseSchema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${origin}/#business`,
    name: site.brand,
    description: site.description,
    url: `${origin}/`,
    logo: `${origin}/brand/mark-512.png`,
    image: `${origin}${site.ogImage}`,
    email: site.contact.email,
    telephone: site.contact.phone,
    slogan: 'Bring your product to life in 3D',
    address: { '@type': 'PostalAddress', addressLocality: 'Cairo', addressCountry: 'EG' },
    areaServed: { '@type': 'Place', name: 'Worldwide' },
    availableLanguage: ['English', 'Arabic'],
    contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: site.contact.email, telephone: site.contact.phone, url: `${origin}/contact/`, availableLanguage: ['English', 'Arabic'] },
    founder: { '@id': `${origin}/#person` },
    knowsAbout: ['3D product animation', 'Product visualization', '3D rendering', 'CGI product video', 'Exploded view animation', 'Mechanism animation', 'Product launch video', 'Industrial design', 'CAD visualization'],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: '3D product animation & visualization services',
      itemListElement: services.map((sv) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: sv.title, description: sv.short, url: `${origin}/services/${sv.slug}/` } })),
    },
    ...(sameAs.length ? { sameAs } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${origin}/#person`,
    name: site.person,
    jobTitle: site.jobTitle,
    description: `${site.person} is a 3D product animator with a background in industrial design, creating cinematic 3D product animations and product visualizations for brands, startups and manufacturers.`,
    knowsAbout: ['3D product animation', 'Product visualization', 'Industrial design', '3D modeling', 'CGI'],
    address: { '@type': 'PostalAddress', addressLocality: 'Cairo', addressCountry: 'EG' },
    image: `${origin}/media/about/walaa-ramadan.jpg`,
    email: site.contact.email,
    telephone: site.contact.phone,
    url: `${origin}/about/`,
    worksFor: { '@id': `${origin}/#business` },
    ...(sameAs.length ? { sameAs } : {}),
  },
];

if (breadcrumbs?.length) {
  baseSchema.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: abs(Astro.site!, b.href),
    })),
  });
}
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="author" content={site.person} />
    <meta name="theme-color" content={site.themeColor} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Walaa 3D Animation — Blog" href="/rss.xml" />
    <link rel="help" type="text/plain" href="/llms.txt" title="LLM-readable site summary" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />

    {import.meta.env.PROD && site.gaId && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
        <script is:inline define:vars={{ gaId: site.gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    {[...baseSchema, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-canvas">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />

    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>
