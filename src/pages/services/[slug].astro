---
import { originOf } from '@/config/urls';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Faq from '@/components/Faq.astro';
import Icon from '@/components/Icon.astro';
import { services, process, type Service } from '@/data/services';
import { projects } from '@/data/projects';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;
const origin = originOf(Astro.site!);

// Related work: projects for this service first, then fill with others.
const related = [...projects.filter((p) => p.service === service.key), ...projects.filter((p) => p.service !== service.key)].slice(0, 3);
const others = services.filter((s) => s.slug !== service.slug);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    serviceType: service.title,
    description: service.seoDescription,
    url: `${origin}/services/${service.slug}/`,
    provider: { '@id': `${origin}/#business` },
    areaServed: 'Worldwide',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: service.title,
      itemListElement: service.includes.map((inc) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: inc.title, description: inc.text } })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={service.seoTitle} description={service.seoDescription} breadcrumbs={[{ name: 'Services', href: '/services/' }, { name: service.title, href: `/services/${service.slug}/` }]} schema={schema}>
  <section class="container-x pt-32 sm:pt-40">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-soft" data-reveal>
      <a href="/services/" class="link-underline">Services</a> <span class="mx-2 text-ink-faint">/</span> <span>{service.title}</span>
    </nav>
    <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="eyebrow" data-reveal>{service.kicker}</p>
        <h1 class="mt-5 font-display text-[clamp(2.75rem,7vw,6.5rem)] font-medium leading-[0.95] tracking-[-0.03em]" data-reveal>{service.title}</h1>
      </div>
      <div class="lg:col-span-4" data-reveal>
        <p class="prose-body">{service.intro}</p>
        <a href="/contact/" class="btn btn-gold mt-8">Start a Project <Icon name="arrow" class="arrow size-4" /></a>
      </div>
    </div>
  </section>

  <section class="container-x py-20 sm:py-28" aria-labelledby="includes-title">
    <h2 id="includes-title" class="eyebrow">What's included</h2>
    <ul class="mt-10 grid gap-px overflow-hidden rounded-[1.5rem] bg-line ring-1 ring-line sm:grid-cols-2 lg:grid-cols-3">
      {service.includes.map((inc, i) => (
        <li class="bg-surface p-8 transition-colors duration-500 hover:bg-gold-pale" data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
          <span class="font-display text-sm text-gold-deep">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-6 font-display text-2xl font-medium">{inc.title}</h3>
          <p class="mt-2 leading-relaxed text-ink-soft">{inc.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-y border-line bg-mist/60 py-20 sm:py-24" aria-labelledby="uses-title">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">Use it for</p>
        <h2 id="uses-title" class="mt-5 font-display text-4xl font-medium">Made for every channel</h2>
      </div>
      <ul class="flex flex-wrap content-start gap-3 lg:col-span-8">
        {service.useCases.map((u) => <li class="rounded-full bg-surface px-5 py-3 font-display text-lg ring-1 ring-line">{u}</li>)}
      </ul>
    </div>
  </section>

  <section class="container-x py-20 sm:py-28" aria-labelledby="related-title">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeader eyebrow="Selected work" title="Related projects" id="related-title" />
      <a href="/work/" class="btn btn-ghost">All work <Icon name="arrow" class="arrow size-4" /></a>
    </div>
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {related.map((p) => <ProjectCard project={p} mediaIndex={p.media.length > 1 ? 1 : 0} />)}
    </div>
  </section>

  <section class="container-x pb-8" aria-labelledby="svc-process-title">
    <h2 id="svc-process-title" class="eyebrow">Process</h2>
    <ol class="mt-8 grid gap-px overflow-hidden rounded-[1.5rem] bg-line ring-1 ring-line sm:grid-cols-5">
      {process.map((st) => (
        <li class="bg-surface p-6">
          <span class="font-display text-sm text-gold-deep">{st.n}</span>
          <h3 class="mt-3 font-display text-lg font-medium">{st.title}</h3>
        </li>
      ))}
    </ol>
  </section>

  <Faq items={service.faqs} title={`${service.title} FAQ`} />

  <section class="container-x" aria-labelledby="other-title">
    <h2 id="other-title" class="eyebrow">Other services</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {others.map((s) => (
        <a href={`/services/${s.slug}/`} class="group flex items-center justify-between gap-6 rounded-[1.25rem] bg-surface p-7 ring-1 ring-line transition-all hover:ring-gold">
          <span>
            <span class="block font-display text-2xl font-medium">{s.title}</span>
            <span class="mt-1 block text-sm text-ink-soft">{s.short}</span>
          </span>
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-gold-pale transition-colors group-hover:bg-gold"><Icon name="arrow-up-right" class="size-5" /></span>
        </a>
      ))}
    </div>
  </section>

  <CtaBand />
</BaseLayout>
