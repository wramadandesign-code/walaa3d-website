---
import { originOf } from '@/config/urls';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import VideoLoop from '@/components/VideoLoop.astro';
import { services, process } from '@/data/services';

const visuals: Record<string, string> = {
  animation: 'cleaning-robot-vertical',
  visualization: 'water-heater',
  design: 'handheld-device',
};
const origin = originOf(Astro.site!);
const schema = services.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  description: s.short,
  url: `${origin}/services/${s.slug}/`,
  provider: { '@id': `${origin}/#business` },
  areaServed: 'Worldwide',
}));
---

<BaseLayout
  title="3D Animation & Visualization Services"
  description="3D product animation, photoreal product visualization and industrial design support for brands, startups and manufacturers — films, exploded views and renders."
  breadcrumbs={[{ name: 'Services', href: '/services/' }]}
  schema={schema}
>
  <section class="container-x pb-10 pt-36 sm:pt-44">
    <SectionHeader as="h1" eyebrow="Services" title="Services for products that deserve to be seen" intro="Everything starts from an accurate 3D model of your product — then becomes animation, imagery or design support, depending on what you need." />
  </section>

  <div class="container-x space-y-6 pb-8">
    {services.map((s, i) => (
      <section class:list={['grid overflow-hidden rounded-[1.75rem] ring-1 lg:grid-cols-12', s.primary ? 'bg-ink text-canvas ring-ink' : 'bg-surface ring-line']} aria-labelledby={`svc-${s.slug}`} data-reveal>
        <div class:list={['p-8 sm:p-12 lg:col-span-7', i % 2 === 1 && 'lg:order-2']}>
          <div class="flex items-center gap-4">
            <span class:list={['grid size-12 place-items-center rounded-full', s.primary ? 'bg-gold text-ink' : 'bg-gold-pale text-gold-deep']}><Icon name={s.icon} class="size-6" /></span>
            <span class:list={['text-xs uppercase tracking-[0.16em]', s.primary ? 'text-gold' : 'text-ink-faint']}>{s.kicker}</span>
          </div>
          <h2 id={`svc-${s.slug}`} class="mt-8 font-display text-4xl font-medium sm:text-5xl">{s.title}</h2>
          <p class:list={['mt-4 max-w-xl text-lg leading-relaxed', s.primary ? 'text-canvas/70' : 'text-ink-soft']}>{s.intro}</p>
          <ul class="mt-8 grid gap-x-6 gap-y-3 sm:grid-cols-2">
            {s.includes.map((inc) => (
              <li class:list={['flex items-center gap-3 text-sm', s.primary ? 'text-canvas/85' : 'text-ink']}>
                <Icon name="check" class={`size-4 shrink-0 ${s.primary ? 'text-gold' : 'text-gold-deep'}`} />{inc.title}
              </li>
            ))}
          </ul>
          <a href={`/services/${s.slug}/`} class:list={['btn mt-10', s.primary ? 'btn-gold' : 'btn-ghost']}>Explore {s.title} <Icon name="arrow" class="arrow size-4" /></a>
        </div>
        <div class:list={['relative min-h-80 bg-night lg:col-span-5', i % 2 === 1 && 'lg:order-1']}>
          <div class="absolute inset-0"><VideoLoop name={visuals[s.key]} label={`${s.title} example`} /></div>
        </div>
      </section>
    ))}
  </div>

  <section class="container-x py-24 sm:py-28" aria-labelledby="process-title">
    <SectionHeader eyebrow="Process" title="How a project works" id="process-title" />
    <ol class="mt-12 grid gap-px overflow-hidden rounded-[1.5rem] bg-line ring-1 ring-line sm:grid-cols-2 lg:grid-cols-5">
      {process.map((st) => (
        <li class="bg-surface p-7">
          <span class="font-display text-4xl font-light text-gold-deep">{st.n}</span>
          <h3 class="mt-8 font-display text-xl font-medium">{st.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{st.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <CtaBand />
</BaseLayout>
