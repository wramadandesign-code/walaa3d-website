---
import { originOf } from '@/config/urls';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import VideoLoop from '@/components/VideoLoop.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/config/site';

const values = [
  { title: 'Accuracy first', text: 'Your product is modeled from CAD or references and checked against them — proportions, materials and details stay true to the real thing.' },
  { title: 'Story over spectacle', text: 'Every camera move has a job: to show a feature, explain a mechanism or build desire. Beautiful, but always purposeful.' },
  { title: 'Made for real channels', text: 'Deliverables are planned for where they will live — website hero, product page, Reels, trade-show screen or pitch deck.' },
];
const origin = originOf(Astro.site!);
const schema = [{ '@context': 'https://schema.org', '@type': 'AboutPage', name: `About ${site.person}`, url: `${origin}/about/`, mainEntity: { '@id': `${origin}/#person` } }];
---

<BaseLayout
  title={`About ${site.person}`}
  description={`${site.person} is a 3D product animator with an industrial-design background, creating cinematic product animations for brands and manufacturers.`}
  breadcrumbs={[{ name: 'About', href: '/about/' }]}
  schema={schema}
>
  <section class="container-x grid gap-14 pb-20 pt-36 sm:pt-44 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-6">
      <SectionHeader as="h1" eyebrow="About" title="Hi, I'm Walaa. I bring products to life in 3D." />
      <div class="mt-8 space-y-5" data-reveal>
        <p class="prose-body">I'm a 3D product animator with a background in industrial design. I create cinematic 3D product animations and product visualizations for brands, startups and manufacturers.</p>
        <p class="prose-body">Because I come from product design, I don't just make things look good — I understand how they are built, what makes them different and which details your customers need to see. I combine 3D design, visualization and AI-assisted workflows to create engaging product content, efficiently.</p>
      </div>
      <a href="/contact/" class="btn btn-gold mt-10" data-reveal>Start a Project</a>
    </div>
    <figure class="relative lg:col-span-5 lg:col-start-8" data-reveal>
      <picture>
        <source srcset="/media/about/walaa-ramadan.webp" type="image/webp" />
        <img
          src="/media/about/walaa-ramadan.jpg"
          alt={`${site.person}, 3D product animator and industrial designer`}
          width="800"
          height="800"
          fetchpriority="high"
          decoding="async"
          class="aspect-square w-full rounded-[1.75rem] bg-mist object-cover ring-1 ring-line"
        />
      </picture>
      <figcaption class="absolute -bottom-6 left-6 right-6 flex items-center gap-4 rounded-2xl bg-surface/95 p-4 shadow-xl ring-1 ring-line backdrop-blur sm:left-auto sm:-right-6 sm:max-w-xs">
        <div class="size-14 shrink-0 overflow-hidden rounded-xl bg-night">
          <VideoLoop name="handheld-device" label="Exploded view animation by Walaa" width={1080} height={1920} />
        </div>
        <div>
          <p class="font-display text-lg font-medium leading-tight">{site.person}</p>
          <p class="mt-0.5 text-xs uppercase tracking-[0.14em] text-ink-soft">3D Product Animator</p>
        </div>
      </figcaption>
    </figure>
  </section>

  <section class="border-y border-line bg-mist/60 py-24 sm:py-28" aria-labelledby="values-title">
    <div class="container-x">
      <SectionHeader eyebrow="How I work" title="Principles behind every project" id="values-title" />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {values.map((v, i) => (
          <div class="rounded-[1.5rem] bg-surface p-8 ring-1 ring-line" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="font-display text-sm text-gold-deep">0{i + 1}</span>
            <h3 class="mt-6 font-display text-2xl font-medium">{v.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-soft">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-x grid gap-10 py-24 lg:grid-cols-12" aria-labelledby="industries-title">
    <div class="lg:col-span-4">
      <p class="eyebrow">Industries</p>
      <h2 id="industries-title" class="mt-5 font-display text-4xl font-medium">Products I love to animate</h2>
    </div>
    <ul class="flex flex-wrap content-start gap-3 lg:col-span-8">
      {['Robotics', 'Consumer electronics', 'Smart home devices', 'Medical devices', 'Home appliances', 'Industrial equipment', 'Wearables', 'Hardware startups'].map((x) => (
        <li class="rounded-full bg-surface px-5 py-3 font-display text-lg ring-1 ring-line">{x}</li>
      ))}
    </ul>
  </section>

  <CtaBand />
</BaseLayout>
